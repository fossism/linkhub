{
  "manifest_version": 3,
  "name": "LinkHub Tab Saver",
  "version": "0.1.0",
  "description": "Save all open tabs to your self-hosted LinkHub in one click. No more bookmark juggling.",
  "permissions": ["tabs", "storage", "contextMenus", "sidePanel"],
  "side_panel": { "default_path": "sidepanel.html" },
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkHub Tab Saver"
  },
  "background": {
    "service_worker": "background.js"
  }
}
